---
import '../styles/global.css';
import {
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_LANG,
  SITE_AUTHOR,
  absolute,
  canonical,
  getPages,
  metaDescription,
  withBase,
} from '../lib/site';

interface Props {
  /** The page's own title; the site name is added after it. Omit on the home page. */
  title?: string;
  description?: string;
  /** The root-relative path of this page, as on saemundsson.se ("/2026/10/19/slug/"). */
  path: string;
  /** A root-relative or absolute image for link previews. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  noindex?: boolean;
  /** Send the visitor to this URL at once (a page WordPress redirected). */
  redirect?: string;
}

const { title, description, path, image, imageAlt, type = 'website', published, modified, noindex = false, redirect } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} | ${SITE_TAGLINE}`;
const desc = metaDescription(description || SITE_TAGLINE);
const canonicalUrl = canonical(path);
const imageUrl = image ? (/^https?:\/\//.test(image) ? image : absolute(image, Astro.site)) : undefined;
const feedUrl = withBase('/feed.xml');
const pages = (await getPages()).filter((p) => p.data.redirect && p.data.menu);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    {redirect && <meta http-equiv="refresh" content={`0; url=${redirect}`} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FBF8F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181614" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} feed`} href={feedUrl} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt || title || SITE_TITLE} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={desc} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={imageAlt || title || SITE_TITLE} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={withBase('/')}>
          <span class="brand-name">{SITE_TITLE}</span>
        </a>
        <nav aria-label="Site">
          <ul>
            <li><a href={withBase('/')}>Posts</a></li>
            {pages.map((p) => <li><a href={p.data.redirect} rel="me">{p.data.title}</a></li>)}
            <li><a href={feedUrl}>RSS</a></li>
          </ul>
        </nav>
        <button type="button" class="theme-toggle" id="theme-toggle" hidden aria-label="Switch to dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-tagline">{SITE_TITLE}: {SITE_TAGLINE.toLowerCase()}.</p>
        <p>&copy; {year} {SITE_AUTHOR}</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var b = document.getElementById('theme-toggle'), r = document.documentElement;
        function sync() { b.setAttribute('aria-label', r.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'); }
        b.hidden = false;
        sync();
        b.addEventListener('click', function () {
          var t = r.dataset.theme === 'dark' ? 'light' : 'dark';
          r.dataset.theme = t;
          try { localStorage.setItem('theme', t); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
