---
import { categoryName, categoryPath, formatDate, metaDescription, readingMinutes, tagName, tagPath, withBase } from '../lib/site';

interface Props {
  title: string;
  date?: Date;
  modified?: Date;
  categories?: string[];
  tags?: string[];
  /** Shown above the text when the text doesn't already show it. */
  image?: string;
  imageAlt?: string;
  body?: string;
  description?: string;
  draft?: boolean;
}

const { title, date, modified, categories = [], tags = [], image, imageAlt = '', body = '', description, draft = false } = Astro.props;
const day = (d: Date) => d.toISOString().slice(0, 10);
const showModified = date && modified && day(modified) > day(date);
const showImage = image && !body.includes(image);
// No lede when the text itself opens with the same words.
const norm = (t: string) => t.replace(/[^\p{L}\p{N}]+/gu, ' ').trim().toLowerCase().slice(0, 50);
const showLede = !!description && norm(body) !== norm(description);
const shownCategories = categories.filter((c) => c !== 'uncategorized');
---
<article class="post">
  <header class="post-header">
    {
      (date || shownCategories.length > 0) && (
        <p class="kicker">
          {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
          {date && shownCategories.length > 0 && <span aria-hidden="true"> · </span>}
          {shownCategories.length > 0 && (
            <a href={withBase(categoryPath(shownCategories[0]))} rel="category">
              {categoryName(shownCategories[0])}
            </a>
          )}
        </p>
      )
    }
    <h1>
      {title}
      {draft && <span class="badge">Draft</span>}
    </h1>
    {showLede && description && <p class="lede">{metaDescription(description, 300)}</p>}
    <p class="meta">
      {
        showModified && modified && (
          <>
            <span>
              Updated <time datetime={modified.toISOString()}>{formatDate(modified)}</time>
            </span>
            <span aria-hidden="true"> · </span>
          </>
        )
      }
      <span>{readingMinutes(body)} min read</span>
    </p>
    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((t) => (
            <li>
              <a href={withBase(tagPath(t))} rel="tag">
                {tagName(t)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </header>
  {
    showImage && image && (
      <figure class="featured">
        <img src={/^https?:/.test(image) ? image : withBase(image)} alt={imageAlt} decoding="async" />
      </figure>
    )
  }
  <div class="prose">
    <slot />
  </div>
</article>
